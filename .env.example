# Database Configuration
POSTGRES_DB=datenschutz_rechtsprechung_api
POSTGRES_USER=dsr_user
POSTGRES_PASSWORD=secure-db-password-change-me

# Redis Configuration
REDIS_PASSWORD=secure-redis-password-change-me

# Application Secrets
API_SECRET_KEY=api-secret-key-change-in-production
FLASK_SECRET_KEY=flask-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Environment
LOG_LEVEL=INFO
SENTRY_DSN=

# Mail Configuration (for password reset)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=mail-app-password
MAIL_USE_TLS=true

# Domain Configuration
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@localhost

# Optional: External Monitoring
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
