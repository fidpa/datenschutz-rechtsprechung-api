# =============================================================================
# Production Environment Variables für Datenschutz-Rechtsprechung API
# =============================================================================
# WICHTIG: Kopieren Sie diese Datei nach .env.production und füllen Sie
# alle Werte aus. Verwenden Sie scripts/security/generate_secrets.sh
# um sichere Secrets zu generieren.
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=info
DEBUG=false

# =============================================================================
# Security (MUSS geändert werden!)
# =============================================================================
# Generieren mit: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT

# CORS Settings
CORS_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com", "www.your-domain.com"]

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=datenschutz_rechtsprechung_api
POSTGRES_USER=dsr_user
# Generieren mit: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Redis Configuration
# =============================================================================
# Generieren mit: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery Settings
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60

# Gunicorn Settings
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# =============================================================================
# Crawler Settings
# =============================================================================
GDPRHUB_MAX_PAGES=1000
CRAWLER_USER_AGENT=datenschutz-rechtsprechung-api/1.0 (https://your-domain.com)
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# Rate Limiting (requests per second)
GDPRHUB_RATE_LIMIT=0.5
OPENLEGALDATA_RATE_LIMIT=3.0
RIS_RATE_LIMIT=5.0

# =============================================================================
# Monitoring & Alerting
# =============================================================================
# Grafana Admin Credentials
# Generieren mit: openssl rand -base64 16
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT
GRAFANA_PORT=3000

# Prometheus Settings
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your-key@sentry.io/project-id

# Optional: Email Alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=admin@your-domain.com

# =============================================================================
# Nginx Configuration
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL Certificate Paths (für Let's Encrypt)
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=30
BACKUP_MONTHLY_RETENTION_DAYS=365

# Optional: S3-compatible backup storage
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=datenschutz-rechtsprechung-api-backups

# =============================================================================
# Performance Tuning
# =============================================================================
# PostgreSQL Tuning
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# Redis Memory Limit
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true
ENABLE_BACKUP_AUTOMATION=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true

# =============================================================================
# Development/Debug (sollte in Production false sein)
# =============================================================================
SQLALCHEMY_ECHO=false
PROFILING_ENABLED=false
DEBUG_TOOLBAR_ENABLED=false

# =============================================================================
# ENDE - Vergessen Sie nicht scripts/security/generate_secrets.sh auszuführen!
# =============================================================================