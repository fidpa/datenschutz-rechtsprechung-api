[flake8]
# Black owns code formatting; flake8 guards correctness (all F-codes stay on).
#
# CI runs `flake8 .` over the whole tree, so `src`, `scripts` and `tests` are
# all gated. The gate is kept wide on purpose: F821 (undefined name) is a
# runtime NameError wherever it appears, and three of them sat unnoticed in
# scripts/ and tests/ because an earlier revision of this file claimed the CI
# only linted `src`. Housekeeping codes are waived per directory below instead
# of narrowing the gate.
#
# Deliberately ignored, with rationale:
#   E203,W503   black-compatibility (PEP 8 disagrees with black here)
#   E501        line length is enforced by black (100), not flake8
#   W291,W293   trailing/blank whitespace inside German docstrings & HTML
#               email templates — not code; black does not touch string bodies
#   F541        f-string without placeholder — harmless, legacy strings
#   E402        module-level import after sys.path bootstrap (intentional
#               pattern in entrypoints/scripts importing `src`)
#   E712        `== True` comparisons in legacy SQLAlchemy filter expressions
#   E722        bare `except:` — 31 legacy sites, tracked Alpha cleanup
#               (see README § Project Status); correctness F-codes still catch
#               real issues
max-line-length = 100
extend-ignore =
    E203,
    W503,
    E501,
    W291,
    W293,
    F541,
    E402,
    E712,
    E722
exclude =
    .git,
    .venv,
    __pycache__,
    docs.legacy,
    archive,
    htmlcov,
    build,
    dist,
    .pytest_cache,
    migrations
per-file-ignores =
    __init__.py:F401
# Test modules and one-off scripts accumulate imports and bindings that are kept
# for readability or were left behind by a refactor. Waived here rather than in
# `extend-ignore`, so F401/F841 keep gating `src`.
    tests/*:F401,F841
    scripts/*:F401,F841
max-complexity = 30
