# Test-Container für Datenschutz-Rechtsprechung API
FROM python:3.11-slim

# System-Dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Working Directory
WORKDIR /app

# Python Dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Test-spezifische Dependencies
RUN pip install --no-cache-dir \
    pytest==7.4.3 \
    pytest-cov==4.1.0 \
    pytest-asyncio==0.21.1 \
    pytest-timeout==2.2.0 \
    pytest-xdist==3.5.0 \
    fakeredis==2.20.1 \
    factory-boy==3.3.0 \
    hypothesis==6.92.1 \
    locust==2.20.0 \
    memory-profiler==0.61.0 \
    matplotlib==3.8.2 \
    seaborn==0.13.0 \
    pandas==2.1.4 \
    ijson==3.2.3

# spaCy Model für Tests
RUN python -m spacy download de_core_news_sm

# Kopiere Source Code
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p reports data/cache logs

# Set Python Path
ENV PYTHONPATH=/app

# Default Command
CMD ["pytest", "tests/", "-v"]