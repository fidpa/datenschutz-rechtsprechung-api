# Multi-stage build für Flask Web-UI
FROM python:3.11-slim as base

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies for Web UI
COPY src/web/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Development stage
FROM base as development
COPY . .
CMD ["python", "src/web/development_server.py"]

# Production stage
FROM base as production

# Create non-root user
RUN groupadd -r dsr && useradd -r -g dsr dsr

# Copy application
COPY --chown=dsr:dsr . .

# Create necessary directories
RUN mkdir -p /app/logs /app/sessions && \
    chown -R dsr:dsr /app/logs /app/sessions

# Install production server
RUN pip install --no-cache-dir waitress

# Switch to non-root user
USER dsr

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5001/system/health || exit 1

# Production command
CMD ["python", "src/web/production_server.py"]